# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email Configuration (Optional - for direct server-side email dispatch to destination)
# If not provided, the app provides 1-Click Gmail/Webmail/Mailto dispatch directly to recipient inbox.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Poly Cables <your-email@gmail.com>"
SMTP_SECURE="false"

# Supabase Secondary Cloud Fallback (Optional)
# Used automatically if Firebase Firestore fails or daily quota is exceeded
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SYNC_TABLE="app_sync_store"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional project-wide Firestore read/write counts on the admin dashboard.
# Enable monitoring.googleapis.com and grant the server's Application Default
# Credentials the Monitoring Viewer role for the target project. On Cloud Run,
# grant that role to the service account; locally, configure Google ADC.
FIRESTORE_USAGE_PROJECT_ID=""
# Spark daily operation limits. Override these for a different plan or quota.
FIRESTORE_USAGE_READ_LIMIT="50000"
FIRESTORE_USAGE_WRITE_LIMIT="20000"
FIRESTORE_USAGE_DELETE_LIMIT="20000"
# Generate a random 32+ character token (for example: openssl rand -base64 32).
# Keep it server-only; authorized admins enter it in the dashboard.
FIRESTORE_USAGE_ADMIN_TOKEN=""

